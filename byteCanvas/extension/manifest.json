{
  "manifest_version": 3,
  "name": "NUS Secure Access",
  "version": "1.0",
  "description": "Security extension for NUS students",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.nus.edu.sg/*",
    "*://*.nusmods.com/*",
    "*://*.ivle.nus.edu.sg/*",
    "*://*.webmail.nus.edu.sg/*",
    "*://*.outlook.office.com/*",
    "*://*.office365.com/*",
    "*://*.instructure.com/*",
    "*://*.canvas.nus.edu.sg/*",
    "*://canvas.nus.edu.sg/*",
    "*://*.luminus.nus.edu.sg/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.nus.edu.sg/*",
        "*://*.nusmods.com/*",
        "*://*.ivle.nus.edu.sg/*",
        "*://*.webmail.nus.edu.sg/*",
        "*://*.outlook.office.com/*",
        "*://*.office365.com/*",
        "*://*.instructure.com/*",
        "*://*.canvas.nus.edu.sg/*",
        "*://canvas.nus.edu.sg/*",
        "*://*.luminus.nus.edu.sg/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
} 